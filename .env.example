# --- Frodobots SDK server env (used by the SDK's own `hypercorn main:app`, NOT this client) ---
# Get token at https://my.frodobots.com/owner/settings after activating a bot (or a challenge allocation).
SDK_API_TOKEN=
BOT_SLUG=
CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
MISSION_SLUG=            # set to enable the Missions API (start-mission / checkpoints)

# --- this client / follower (all Config fields are UPPERCASE env overrides) ---
SDK_BASE_URL=http://localhost:8000
CHECKPOINT_RADIUS_M=5    # gate to start asking the server "reached?"
CRUISE=0.6              # forward throttle when aligned (0..1)
KP_ANG=1.5             # steering gain
ALIGN_DEG=20           # within this heading error -> full cruise
DEADBAND_DEG=3         # ignore tiny errors (anti-jitter)
APPROACH_M=6           # start slowing within this distance of a waypoint
MIN_CREEP=0.25         # floor on approach-slowdown factor
MAX_DANG=0.35          # max angular change per step (slew limit, anti-oscillation)
LOOP_HZ=5
STUCK_S=20             # no progress this long -> start the recovery ladder
RECOVERY_TRIES=3       # back-up-and-turn attempts before trying a different approach
RECOVERY_PAUSE_S=0.4
RECOVERY_REVERSE_S=1.5
RECOVERY_REVERSE_THROTTLE=0.35
RECOVERY_YAW_S=1.5
RECOVERY_YAW=0.6
RECOVERY_OFFSET_M=8    # detour this far to the side of the checkpoint (0 disables)
DETOUR_RADIUS_M=3      # close enough to the detour point
DETOUR_TIMEOUT_S=45
MAX_RUNTIME_S=3600
MAX_CONSECUTIVE_ERRORS=20  # consecutive failed steps before declaring the link dead
STOP_ATTEMPTS=10           # tries to get the rover stopped on the way out
HEADING_MIN_MOVE_M=0.7  # move at least this far to trust GPS course over the magnetometer

# --- heading estimation (heading.py) ---
HEADING_MIN_MOVE_M=8        # ODOMETRY baseline a GPS course must cover to be trusted
HEADING_MAX_TURN_DEG=30     # reject the course if the rover turned this much covering it
HEADING_GAIN=0.25           # floor on the correction gain (first fixes correct harder)
HEADING_SLIP_RATIO=0.75     # GPS chord < this * odometry => wheels slipping, reject
HEADING_ANCHOR_MAX_AGE_S=30
HEADING_MIN_LINEAR=0.05     # commanded throttle below this = not moving
HEADING_MIN_SPEED=0.05      # telemetry speed below this = not moving
YAW_RATE_DPS=90             # deg/s at angular=1.0, the dead-reckoning model
MAX_SPEED_MPS=1.5           # m/s at linear=1.0, odometry model when /data has no speed
USE_GYRO=0                  # 1 = take yaw rate from /data gyros (verify axis+units first!)

# magnetometer SEED only — used for the very first heading, then never read again:
# heading_deg = HEADING_SIGN * orientation * HEADING_SCALE + HEADING_OFFSET
# Get it roughly right (calibrate_heading.py): a bad seed means the first turn goes the
# wrong way, until the first GPS course lands and corrects it.
HEADING_SCALE=1.4117647   # 360/255
HEADING_OFFSET=0
HEADING_SIGN=1

# --- fake server only (all default to "off" so the deterministic quick-start still passes) ---
FAKE_FAIL_RATE=0                 # inject transient 503s at this rate to test client retry
FAKE_ACCEPT_RADIUS_M=15          # server-side checkpoint tolerance (challenge Urban value)
FAKE_GPS_SIGMA_M=0               # per-fix white noise, metres (realistic urban: 1.5)
FAKE_GPS_BIAS_M=0                # slow drift magnitude, metres (realistic urban: 5-10)
FAKE_GPS_BIAS_PERIOD_S=120       # how long the bias takes to rotate once
FAKE_TELEMETRY_LATENCY_S=0       # /data reports where the bot WAS (realistic: 0.3-0.5)
FAKE_CONTROL_DROP_RATE=0         # commands silently lost over RTM (HTTP still 200s)
FAKE_BATTERY_DRAIN_PCT_PER_MIN=0 # battery drain rate
FAKE_GPS_SIGNAL=31               # reported gps_signal
FAKE_START_MISSION_UNAVAILABLE=0 # 1 -> 400 "Bot unavailable for SDK"
FAKE_SEED=0                      # deterministic noise/drop sequences

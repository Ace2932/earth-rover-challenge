# --- Frodobots SDK server env (used by the SDK's own `hypercorn main:app`, NOT this client) ---
# Get token at https://my.frodobots.com/owner/settings after activating a bot (or a challenge allocation).
SDK_API_TOKEN=
BOT_SLUG=
CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
MISSION_SLUG=            # set to enable the Missions API (start-mission / checkpoints).
                         # LEAVE UNSET on a bot you own: the SDK then serves plain ride
                         # tokens, but /checkpoints-list returns {} and
                         # /checkpoint-reached 500s, so use --route (see #79).

# --- this client / follower (all Config fields are UPPERCASE env overrides) ---
SDK_BASE_URL=http://localhost:8000
CHECKPOINT_RADIUS_M=20   # start asking the server "reached?" inside this (its own
                         # tolerance is 15 m — ask early, the server decides)
CHECKPOINT_POLL_S=1.0    # how often to ask while inside that radius
SERVER_DIST_MAX_AGE_S=3  # after this, navigate on our own haversine again
LOCAL_ARRIVE_M=5         # --route ONLY: with no mission there is no server to confirm
                         # anything, so this is what "arrived" means. Tighter than the
                         # challenge's 15 m on purpose — the only judge left is the same
                         # fix we are steering on. Must stay BELOW CAPTURE_SPACING_M.
CRUISE=0.6              # forward throttle when aligned (0..1)
KP_ANG=1.5             # steering gain
ALIGN_DEG=20           # within this heading error -> full cruise
DEADBAND_DEG=3         # ignore tiny errors (anti-jitter)
APPROACH_M=6           # start slowing within this distance of a waypoint
BEARING_TRUST_M=5      # below this the bearing is GPS noise — damp the turn (0 = off)
MIN_CREEP=0.25         # floor on approach-slowdown factor
MAX_DANG=0.35          # max angular change per step (slew limit, anti-oscillation)
RECOVERY_TRIES=3       # back-up-and-turn attempts before trying a different approach
RECOVERY_PAUSE_S=0.4
RECOVERY_REVERSE_S=1.5
RECOVERY_REVERSE_THROTTLE=0.35
RECOVERY_YAW_S=1.5
RECOVERY_YAW=0.6
RECOVERY_OFFSET_M=8    # detour this far to the side of the checkpoint (0 disables)
DETOUR_RADIUS_M=3      # close enough to the detour point
DETOUR_TIMEOUT_S=45
LOOP_HZ=5              # control-loop rate (deadline-based, does not drift with work)
COMMAND_HZ=20          # rate the setpoint is RE-SENT to the bot (SDK teleop uses 20)
SETPOINT_STALE_S=0.5   # setpoint older than this decays to a stop. MUST exceed the
                       # control period 1/LOOP_HZ, or it expires between iterations
                       # and the rover stutters at ~50% duty (#74)
CONTROL_TIMEOUT_S=1.0  # a stale command is worse than a dropped one
DATA_TIMEOUT_S=1.5
HEARTBEAT_PATH=        # file the streamer touches; watchdog.py watches it
STUCK_S=20             # no progress this long -> start the recovery ladder (#22)
MAX_RUNTIME_S=3600
MAX_CONSECUTIVE_ERRORS=20  # consecutive failed steps before declaring the link dead
STOP_ATTEMPTS=10           # tries to get the rover stopped on the way out

# --- obstacle stop (only active with a policy trained via `train.py --blocked`) ---
BLOCKED_P=0.8          # P(blocked) to brake at; 1.0 disables the gate entirely
BLOCKED_FRAMES=2       # consecutive frames over the threshold before braking
BLOCKED_HOLD_S=1.5     # hold the stop this long (stop/go chatter is worse than stopping)
# --- telemetry guards (telemetry.py) ---
BATTERY_ABORT_PCT=15   # park at or below this; a dead rover is also a rover to go and fetch
BATTERY_WARN_PCT=30
GPS_SIGNAL_GOOD=20     # gps_signal units are NOT documented — verify on a real bot.
GPS_SIGNAL_POOR=5      # set GOOD == POOR to disable speed scaling entirely.
MIN_SPEED_SCALE=0.3    # slowest crawl on a bad fix
NO_MOTION_S=4          # commanded to move this long with no wheel motion -> warn
FIX_MAX_AGE_S=3        # /data timestamp frozen this long -> stop; the position is fiction

# --- vision fusion (only used with --vision) ---
VISION_ALPHA=0.5        # weight on VISION steering (0 = pure GPS, 1 = pure vision)
VISION_MAX_ERR_DEG=30   # above this heading error, ignore vision (we're turning in place)
VISION_MIN_LINEAR=0.25  # floor so a timid policy can't stall the rover
FRAME_MAX_AGE_S=0.7     # ignore camera frames older than this (stalled WebRTC stream)

# --- heading estimation (heading.py) ---
HEADING_MIN_MOVE_M=8        # ODOMETRY baseline a GPS course must cover to be trusted
HEADING_MAX_TURN_DEG=90     # NET turn past this and a chord says nothing (#44)
HEADING_MAX_ABS_TURN_DEG=540 # loose sanity bound on TOTAL |yaw| in one window (#54)
HEADING_MAX_BLIND_S=20      # no correction for this long -> take the next one anyway
HEADING_GAIN=0.25           # floor on the correction gain (first fixes correct harder)
HEADING_SLIP_RATIO=0.75     # GPS chord < this * odometry => wheels slipping, reject
HEADING_JUMP_RATIO=1.5      # GPS chord > this * odometry => the fix jumped, reject (#61)
HEADING_ANCHOR_MAX_AGE_S=30
HEADING_MIN_LINEAR=0.05     # commanded throttle below this = not moving
HEADING_MIN_SPEED=0.05      # telemetry speed below this = not moving
YAW_RATE_DPS=90             # deg/s at angular=1.0, the dead-reckoning model
MAX_SPEED_MPS=1.5           # m/s at linear=1.0, odometry model when /data has no speed
USE_GYRO=0                  # 1 = take yaw rate from /data gyros (verify axis+units first!)

# magnetometer SEED only — used for the very first heading, then never read again:
# heading_deg = HEADING_SIGN * orientation * HEADING_SCALE + HEADING_OFFSET
# Get it roughly right (calibrate_heading.py): a bad seed means the first turn goes the
# wrong way, until the first GPS course lands and corrects it.
HEADING_SCALE=1.4117647   # 360/255
HEADING_OFFSET=0
HEADING_SIGN=1

# --- capture_route.py only (recording a teleop lap into a route file) ---
CAPTURE_HZ=2             # /data polls per second while recording
CAPTURE_SPACING_M=10     # min gap between kept waypoints. Keep it ABOVE LOCAL_ARRIVE_M
                         # (else every waypoint is reached the instant the last one was)
                         # and above HEADING_MIN_MOVE_M (else the heading filter never
                         # gets a GPS course correction between two waypoints).

# --- fake server only (all default to "off" so the deterministic quick-start still passes) ---
FAKE_FAIL_RATE=0                 # inject transient 503s at this rate to test client retry
FAKE_ACCEPT_RADIUS_M=15          # server-side checkpoint tolerance (challenge Urban value)
FAKE_GPS_SIGMA_M=0               # per-fix white noise, metres (realistic urban: 1.5)
FAKE_GPS_BIAS_M=0                # slow drift magnitude, metres (realistic urban: 5-10)
FAKE_GPS_BIAS_PERIOD_S=120       # how long the bias takes to rotate once
FAKE_GPS_JUMP_M=0                # multipath: metres the fix steps near buildings (#61)
FAKE_GPS_JUMP_RATE=0             # probability per fix of entering a jump
FAKE_GPS_JUMP_HOLD_S=3           # how long a jump persists before snapping back
FAKE_TELEMETRY_LATENCY_S=0       # /data reports where the bot WAS (realistic: 0.3-0.5)
FAKE_CONTROL_DROP_RATE=0         # commands silently lost over RTM (HTTP still 200s)
FAKE_BATTERY_DRAIN_PCT_PER_MIN=0 # battery drain rate
FAKE_YAW_SCALE=1.0               # gain error between commanded and actual yaw (#56)
FAKE_YAW_NOISE_DPS=0             # per-step yaw error: slip, surface, camber
FAKE_GPS_SIGNAL=31               # reported gps_signal
FAKE_NO_FIX=0                    # 1 -> no GPS lock: lat/lon 1000, fix_quality 0, and a
                                 # timestamp that keeps advancing anyway (#77)
FAKE_START_MISSION_UNAVAILABLE=0 # 1 -> 400 "Bot unavailable for SDK"
FAKE_SEED=0                      # deterministic noise/drop sequences
